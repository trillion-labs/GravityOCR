+def redact_server_args(server_args: Mapping[str, Any]) -> Dict[str, Any]:
+    """A copy of a server-arguments dict (`dataclasses.asdict` / `vars` of ServerArgs) with every
+    secret field set to None. The input is not modified."""
+    redacted = dict(server_args)
+    for name in SECRET_SERVER_ARG_FIELDS:
+        if name in redacted:
+            redacted[name] = None
+    return redacted
+
+
+def server_args_without_secrets(server_args: Any) -> Any:
+    """A shallow copy of a ServerArgs object with every secret field set to None (the object is not
+    re-initialised, so `__post_init__` does not run again). The input is not modified."""
+    stripped = copy.copy(server_args)
+    for name in SECRET_SERVER_ARG_FIELDS:
+        if hasattr(stripped, name):
+            setattr(stripped, name, None)
+    return stripped
