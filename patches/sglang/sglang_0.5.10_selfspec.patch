+def install_auth_middleware(app, *, keys: Callable[[], Any]) -> None:
+    """Add the auth middleware with a key provider that it calls per request.
+
+    http_server calls it once on its module-level app, with http_worker_keys.get_auth_keys, so every
+    tokenizer worker process (each imports that module) has it. Starlette accepts middleware only
+    before the app starts, while a worker learns its keys only at startup: hence the provider.
+    """
+    app.add_middleware(_ApiKeyASGIMiddleware, keys=keys, fastapi_app=app)
