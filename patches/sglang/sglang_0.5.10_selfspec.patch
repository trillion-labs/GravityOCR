+def _run_uvicorn_workers(app_import_path: str, auth_keys: AuthKeys, **config_kwargs):
+    """`uvicorn.run(app_import_path, workers=N, **config_kwargs)` (its multi-worker branch), except
+    that the worker target is wrapped in AuthKeysWorkerTarget: uvicorn pickles the target to every
+    worker process it spawns (and to every worker it restarts), so each worker sets the server's keys
+    before it serves, and the keys never pass through shared memory or the environment."""
+    from uvicorn import Config, Server
+    from uvicorn.supervisors import Multiprocess
+
+    config = Config(app_import_path, **config_kwargs)
+    assert config.workers > 1, "_run_uvicorn_workers is for --tokenizer-worker-num > 1"
+    server = Server(config=config)
+    sock = config.bind_socket()
+    try:
+        Multiprocess(
+            config,
+            target=AuthKeysWorkerTarget(server.run, auth_keys),
+            sockets=[sock],
+        ).run()
+    except KeyboardInterrupt:
+        pass
