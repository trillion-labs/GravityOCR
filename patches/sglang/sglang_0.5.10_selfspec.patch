+def _loopback_rendezvous_store(
+    distributed_init_method: str,
+    rank: int,
+    world_size: int,
+    backend: str,
+    timeout: Optional[timedelta],
+) -> Optional[torch.distributed.Store]:
+    """The store of a ``tcp://<loopback IP>:<port>`` rendezvous, listening on that address only.
+
+    torch's tcp:// rendezvous starts rank 0's TCPStore server on every interface (``::`` /
+    ``0.0.0.0``) whatever host the URL names, so even a loopback rendezvous opened a port that
+    other hosts can reach. For a URL whose host is a loopback IP literal, rank 0 binds that
+    address itself and hands the listening socket to the TCPStore (``master_listen_fd``).
+    Everything else is what torch's tcp:// rendezvous does (``_create_c10d_store``: rank 0
+    serves, the other ranks connect, multi-tenant, ``USE_LIBUV``; ``init_process_group``: the
+    backend's default timeout and the ``PrefixStore("default_pg", ...)`` around the store).
+    Returns None for any other init method, which torch then handles as before.
+    """
+    try:
+        url = urllib.parse.urlsplit(distributed_init_method)
+        host, port = url.hostname, url.port
+    except ValueError:
+        return None
+    if url.scheme != "tcp" or url.path or url.query or url.fragment:
+        return None
+    if host is None or port is None or rank < 0 or world_size < 1:
+        return None
+    try:
+        ip = ipaddress.ip_address(host)
+    except ValueError:  # a host name, not an IP literal
+        return None
+    if not ip.is_loopback:
+        return None
+    if os.environ.get("TORCHELASTIC_USE_AGENT_STORE") == str(True):
+        return None  # torchelastic's agent hosts the store
+    if timeout is None:
+        timeout = torch.distributed.distributed_c10d._get_default_timeout(
+            Backend(backend)
+        )
+    listen_fd = None
+    if rank == 0:
+        family = socket.AF_INET6 if ip.version == 6 else socket.AF_INET
+        sock = socket.socket(family, socket.SOCK_STREAM)
+        try:
+            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            sock.bind((host, port))
+            sock.listen(socket.SOMAXCONN)
+        except BaseException:
+            sock.close()
+            raise
+        # The TCPStore server owns the descriptor from here on (it closes it on shutdown).
+        listen_fd = sock.detach()
+    store = torch.distributed.TCPStore(
+        host_name=host,
+        port=port,
+        world_size=world_size,
+        is_master=rank == 0,
+        timeout=timeout,
+        multi_tenant=True,
+        master_listen_fd=listen_fd,
+        use_libuv=os.environ.get("USE_LIBUV", "1") == "1",
+    )
+    return torch.distributed.PrefixStore("default_pg", store)
+
+
